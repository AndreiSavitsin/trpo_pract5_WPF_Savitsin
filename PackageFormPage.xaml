<Page x:Class="trpo_pract5_WPF_Savitsin.PackageFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:trpo_pract5_WPF_Savitsin"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PackageFormPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Label Content="Id"/>
            <Label Content="Получатель"/>
            <Label Content="Адрес"/>
            <Label Content="Дата отправки"/>
            <Label Content="Вес посылки"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBlock Margin="5" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="5" Text="{Binding Recipient}"/>
            <TextBox Margin="5" Text="{Binding Address}"/>
            <TextBox Margin="5" Text="{Binding SendDate}"/>
            <TextBlock Margin="5" VerticalAlignment="Center" Text="{Binding PackageWeightKg}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal">
                <Button Margin="5" Click="AddItem_Click">Добавить вложение</Button>
                <Button Margin="5" Click="RemoveItem_Click">Удалить вложение</Button>
            </StackPanel>
            <ListView x:Name="ItemsList" ItemsSource="{Binding Items}" Height="200">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Название: " VerticalAlignment="Center"/>
                            <TextBox Width="100" Margin="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Вес: " VerticalAlignment="Center"/>
                            <TextBox Width="50" Margin="2" Text="{Binding UnitWeightKg, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Кол-во: " VerticalAlignment="Center"/>
                            <TextBox Width="50" Margin="2" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Общая масса: " VerticalAlignment="Center"/>
                            <TextBlock Width="100" Margin="2" VerticalAlignment="Center" Text="{Binding ItemWeightKg, UpdateSourceTrigger=PropertyChanged}"/>
                            
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
        
        <StackPanel Grid.Row="2">
            <Button x:Name="SaveButton" Margin="5" Content="Сохранить" Click="SaveButton_Click"/>
            <Button x:Name="BackButton" Margin="5" Content="Назад" Click="BackButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
