<Page x:Class="trpo_pract5_WPF_Savitsin.PackageFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:trpo_pract5_WPF_Savitsin"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PackageFormPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Label Content="Id"/>
            <Label Content="Получатель"/>
            <Label Content="Адрес"/>
            <Label Content="Дата отправки"/>
            <Label Content="Вес посылки"/>
            <Label Content="Название вложения"/>
            <Label Content="Масса единицы, кг"/>
            <Label Content="Количество"/>
            <Label Content="Общая масса данного вложения"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBox Margin="5" Text="{Binding Id}"/>
            <TextBox Margin="5" Text="{Binding Recipient}"/>
            <TextBox Margin="5" Text="{Binding Address}"/>
            <TextBox Margin="5" Text="{Binding SendDate}"/>
            <TextBox Margin="5" Text="{Binding PackageWeightKg}"/>
            <TextBox Margin="5" Text="{Binding Name}"/>
            <TextBox Margin="5" Text="{Binding UnitWeightKg}"/>
            <TextBox Margin="5" Text="{Binding Count}"/>
            <TextBox Margin="5" Text="{Binding ItemWeightKg}"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <Button x:Name="SaveButton" Margin="5" Content="Сохранить" Click="SaveButton_Click"/>
            <Button x:Name="BackButton" Margin="5" Content="Назад" Click="BackButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
